<UserControl x:Class="RazerAudioPC.Pages.EqualizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RazerAudioPC.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MaxHeight="290" />
            <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PresetList" />
        </ScrollViewer>

        <Grid Grid.Row="1" Background="#111111">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="CurveTitle" Style="{StaticResource PageTitle}" FontSize="14" />
            <c:EqualizerGraph x:Name="Graph" Grid.Row="1" Minimum="-5" Maximum="5" />
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock x:Name="Hint" Text="Select Custom to adjust each band" Foreground="#1A1A1A" FontSize="12"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <Button x:Name="FlatButton" Style="{StaticResource PillButton}" Content="SET TO FLAT" Click="Flat_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
