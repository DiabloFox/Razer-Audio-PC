<UserControl x:Class="RazerAudioPC.Pages.RemapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RazerAudioPC.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Opacity="0.55" Margin="0,4,0,8">
                <c:Earbud Width="56" Height="96" Margin="0,0,40,0" IsLit="False" />
                <c:Earbud Width="56" Height="96" IsRight="True" IsLit="False" />
            </StackPanel>

            <!-- Context: media vs calls -->
            <Border HorizontalAlignment="Center" BorderBrush="White" BorderThickness="1" Margin="0,4,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CommonTab" Style="{StaticResource SegmentButton}" Content="MEDIA" GroupName="ctx" IsChecked="True" Checked="Context_Changed" />
                    <RadioButton x:Name="CallTab" Style="{StaticResource SegmentButton}" Content="CALLS" GroupName="ctx" Checked="Context_Changed" />
                </StackPanel>
            </Border>

            <Grid Margin="20,0,20,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="GESTURE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Grid.Column="1" Text="LEFT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Grid.Column="2" Text="RIGHT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
            </Grid>

            <StackPanel x:Name="GestureList" />

            <Border Background="{StaticResource CardBg}" Padding="20,12" Margin="0,1,0,0" Opacity="0.6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TRIPLE TAP" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="SMART SWITCH (fixed)" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Background="{StaticResource CardBg}" Padding="20,12" Margin="0,1,0,0" Opacity="0.6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HOLD 4 SEC." FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="BLUETOOTH PAIR (fixed)" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="MissingBud" Margin="20,14,20,0" FontSize="12" Foreground="#E8A13A" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="Only one earbud is connected. Take both earbuds out of the case to remap both sides." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
