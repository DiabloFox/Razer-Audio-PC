<UserControl x:Class="RazerAudioPC.Pages.QuickConnectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="20,6,20,14" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}"
                       Text="Switch your earbuds' Bluetooth audio between the devices they remember." />
            <ItemsControl x:Name="Hosts" ItemsSource="{Binding QuickConnectHosts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="0,0,0,1" Click="Host_Click" Tag="{Binding}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" Width="28" Margin="0,0,14,0" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14"
                                           Foreground="{StaticResource RazerGreen}"
                                           Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="Connected"
                                               Visibility="{Binding Connected, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="Empty" Text="No known audio source" Foreground="{StaticResource TextSecondary}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,30,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
