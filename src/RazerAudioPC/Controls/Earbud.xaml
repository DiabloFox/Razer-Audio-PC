<UserControl x:Class="RazerAudioPC.Controls.Earbud"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="70" Height="120">
    <!-- Stylised Hammerhead bud: rounded head with glowing logo ring, long stem -->
    <Viewbox>
        <Canvas Width="70" Height="120">
            <Canvas.Effect>
                <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="6" Opacity="0.7" />
            </Canvas.Effect>
            <!-- Stem -->
            <Rectangle Canvas.Left="27" Canvas.Top="36" Width="16" Height="80" RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0B0B0B" Offset="0" />
                        <GradientStop Color="#3A3A3A" Offset="0.45" />
                        <GradientStop Color="#0B0B0B" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Head -->
            <Ellipse Canvas.Left="6" Canvas.Top="2" Width="58" Height="54">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop Color="#444444" Offset="0" />
                        <GradientStop Color="#151515" Offset="0.7" />
                        <GradientStop Color="#050505" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Ear tip (side) -->
            <Ellipse x:Name="Tip" Canvas.Left="50" Canvas.Top="18" Width="16" Height="22" Fill="#1E1E1E" />
            <!-- Logo plate -->
            <Ellipse Canvas.Left="16" Canvas.Top="11" Width="38" Height="36" Fill="#0A0A0A" Stroke="#2E2E2E" StrokeThickness="1" />
            <!-- Chroma glow -->
            <Ellipse x:Name="Glow" Canvas.Left="19" Canvas.Top="14" Width="32" Height="30" Opacity="0.85">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowStop" Color="#44D62C" Offset="0" />
                        <GradientStop Color="#0044D62C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Triple-headed snake mark (simplified) -->
            <Path x:Name="Logo" Fill="#44D62C" Stretch="Uniform" Canvas.Left="25" Canvas.Top="19" Width="20" Height="20"
                  Data="M12,1 C9,4 9,7 11,9 C8,8 5,9 3,12 C6,11 8,12 9,14 C7,15 5,18 6,22 C8,19 10,18 12,18 C14,18 16,19 18,22 C19,18 17,15 15,14 C16,12 18,11 21,12 C19,9 16,8 13,9 C15,7 15,4 12,1 Z" />
        </Canvas>
    </Viewbox>
</UserControl>
