<Window x:Class="RazerAudioPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Razer Audio" Width="440" Height="840" MinWidth="380" MinHeight="600"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource RazerFont}" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.1" RadiusY="0.55">
                <GradientStop Color="#1F3A2A" Offset="0" />
                <GradientStop Color="#222222" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0">
            <TextBlock Text="RAZER AUDIO" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="14,0,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" Width="46" Height="36" Click="Minimize_Click" ToolTip="Minimize">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource IconButton}" Width="46" Height="36" Click="Close_Click" ToolTip="Close">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Page header -->
        <Grid Grid.Row="1" Margin="10,0">
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="Back_Click"
                    Visibility="Collapsed" ToolTip="Back">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="18" />
            </Button>

            <!-- Dashboard logo -->
            <StackPanel x:Name="Logo" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="R A Z E R" Foreground="{StaticResource RazerGreen}" FontSize="9" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="HAMMERHEAD" FontSize="19" FontWeight="SemiBold" />
                    <StackPanel Margin="4,2,0,0">
                        <TextBlock Text="PRO" FontSize="7" FontWeight="Bold" />
                        <TextBlock Text="HYPERSPEED" FontSize="7" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Visibility="Collapsed" />
            <ContentControl x:Name="HeaderRight" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Pages -->
        <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False" />

        <!-- Bottom sheet overlay -->
        <Grid x:Name="SheetOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border Background="#B0000000" MouseLeftButtonDown="SheetBackdrop_Click" />
            <Border x:Name="Sheet" VerticalAlignment="Bottom" Background="{StaticResource SheetBg}" CornerRadius="12,12,0,0"
                    MaxHeight="{Binding ActualHeight, ElementName=Root}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SheetOffset" />
                </Border.RenderTransform>
                <Grid>
                    <ContentControl x:Name="SheetContent" Margin="0,8,0,16" Foreground="{StaticResource SheetText}" />
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                            Width="30" Height="30" Click="SheetClose_Click" ToolTip="Close">
                        <Grid>
                            <Ellipse Width="22" Height="22" Fill="#444444" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="9" Foreground="White" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,24"
                Background="#EE111111" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="16,10"
                Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="12" />
        </Border>
    </Grid>
</Window>
